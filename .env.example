# Port the server listens on
PORT=3000
# SQLite database file
DATABASE_URL=./var/sba.sqlite
# Directory for uploaded images and generated PDFs
STORAGE_DIR=./var/storage
# Secret used to sign the browser cookie. Set a long random value in production.
COOKIE_SECRET=change-me
# Projects untouched for this many hours are deleted. Data is ephemeral by design.
RETENTION_HOURS=24
